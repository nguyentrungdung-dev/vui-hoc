{
  "name": "vui-hoc-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others -n web,worker \"next dev --hostname 127.0.0.1\" \"npm run worker\"",
    "build": "next build",
    "start": "concurrently --kill-others -n web,worker \"next start --hostname 127.0.0.1\" \"npm run worker\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts src/server/*.test.ts",
    "format": "prettier --write src next.config.ts package.json tsconfig.json README.md docs/*.md",
    "format:check": "prettier --check src next.config.ts package.json tsconfig.json README.md docs/*.md",
    "worker": "tsx src/server/worker.ts"
  },
  "dependencies": {
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.8",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
