{
  "name": "vui-hoc-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "format": "prettier --write src next.config.ts package.json tsconfig.json README.md",
    "format:check": "prettier --check src next.config.ts package.json tsconfig.json README.md",
    "check:env": "node scripts/check-env.mjs",
    "build:deploy": "npm run check:env && npm run check:services && npm run build",
    "prestart": "npm run check:env",
    "prod": "npm run build:deploy && npm start",
    "verify": "npm test && npm run build && npm run typecheck",
    "smoke": "node scripts/smoke.mjs",
    "check:services": "node scripts/check-services.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "workflow": "^5.2.3",
    "zod": "^4.6.7",
    "@next/env": "16.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "24.x"
  }
}
