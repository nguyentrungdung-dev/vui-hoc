# Server only. Never use a NEXT_PUBLIC_ prefix for this key.
OPENROUTER_API_KEY=
# Must support images, native PDF input and strict structured outputs.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Cloud deployment: Neon pooled URL with sslmode=require (server only).
# Leave empty ONLY for local file-based development.
DATABASE_URL=
# Connect a PRIVATE Blob store to the Vercel project; Vercel injects this token.
BLOB_READ_WRITE_TOKEN=
# Local-only file storage when DATABASE_URL is empty. Never used on Vercel.
VUIHOC_DATA_DIR=.data
